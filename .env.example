# NTA GTFS-Realtime API key — only needed for live GTFS-R features
# Leave blank for standard (static feed) analysis
NTA_GTFSR_API_KEY=

# Path where the GTFS Ireland static zip is cached (created automatically at startup)
GTFS_STATIC_PATH=data/gtfs_ireland.zip

# Directory where JSON analysis results are stored
RESULTS_PATH=data/analysis_results
